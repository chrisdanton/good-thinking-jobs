# Supabase — get these from supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gmail — used to send approval/notification emails
# GMAIL_USER is your full email address (e.g. hello@weareingoodco.com)
# GMAIL_APP_PASSWORD is a 16-character Google "app password" (NOT your normal password)
#   Create one at: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=you@yourdomain.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Base URL — used in email links
NEXT_PUBLIC_BASE_URL=https://getgoodthinking.com

# Admin panel password — required to log in at /admin (set this to a private value)
ADMIN_PASSWORD=choose-a-strong-password

# Share token — protects /api/share, the endpoint the iPhone share-sheet Shortcut
# posts job links to. Kept separate from ADMIN_PASSWORD so a lost phone can be
# handled by rotating just this value. Generate with: openssl rand -hex 32
SHARE_TOKEN=your-random-share-token

# Cron secret — protects /api/cron/newsletter-digest. Vercel sends this automatically
# to the scheduled Friday digest job. Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret
